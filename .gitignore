# Acquisitions and generated outputs stay on disk, outside code history.
/calibration/data/
/calibration/results/*
!/calibration/results/*.json
/calibration/configs/local.json
/calibration/configs/*.local.json
/simulation/runs/
/verification/
/archives/
*.bag
*.zip
*.tar.gz
*.bundle
*.log

# Historical imported source trees can include generated analysis files.
/simulation/.cache/
**/.DS_Store
