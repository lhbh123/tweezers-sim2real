# Copy to env/local.env and set paths on another server. No package installation.
export XHAND_SIM_ENV=/mnt/workspace/tweezers-software/xhand-sim
export ISAAC_PYTHON="$XHAND_SIM_ENV/bin/python"
# Optional: Python installed separately for the calibration tool.
# export CALIBRATION_PYTHON=/absolute/path/to/python
# Optional: a complete, matching NVIDIA user-space driver profile.
# export XHAND_DRIVER_DIR=/absolute/path/to/driver-libraries
# export XHAND_EGL_CONFIG=/absolute/path/to/nvidia_egl.json
# export XHAND_VULKAN_CONFIG=/absolute/path/to/nvidia_icd.json
